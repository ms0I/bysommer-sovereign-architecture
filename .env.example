# ──────────────────────────────────────────────────────────────────
# By Sommer — Sovereign Intelligence Architecture
# Environment Configuration Template
# 
# Copy this file to `.env` and fill in the values.
# All parameters are required for production deployment unless marked [optional].
# ──────────────────────────────────────────────────────────────────

# ── Base44 Platform ──
BASE44_API_KEY=                          # Base44 API key for backend function auth
BASE44_APP_URL=https://solas-7221afc1.base44.app  # Base44 application base endpoint

# ── Active Inference Engine ──
F_DELTA_THRESHOLD=3.0                   # Variational free-energy divergence threshold for anomaly detection (𝓕Δ ≥ 3.0)
THERMAL_DRIFT_THRESHOLD=1.5             # Thermal drift threshold in °C above baseline (ΔT ≥ 1.5°C)

# ── Economic Parameters (December 10th Surplus Engine) ──
NON_PROFIT_BASELINE_DKK=225             # Monthly non-profit cost baseline (midpoint of 200-250 DKK range)
DEC10_PAYOUT_EPOCH="12-10"              # Annual dividend payout date (December 10th)
COST_COMPUTE_INFRA_DKK=2.10             # Daily compute infrastructure cost (DKK/day)
COST_STORAGE_INDEX_DKK=1.30             # Daily storage & indexing cost (DKK/day)
COST_NETWORK_EGRESS_DKK=0.85             # Daily network egress cost (DKK/day)
COST_API_CALLS_DKK=0.95                  # Daily API calls cost — EUR-Lex, DAWA, Virk (DKK/day)

# ── Danish Government API Endpoints ──
DAWA_API_URL=https://dawa.aws.dk/kommuner  # Danish Address Web API for reverse geocoding
VIRK_CVR_ENDPOINT=https://api.virk.dk     # Danish Business Authority (Virk) CVR lookup endpoint
SKAT_TAX_ENDPOINT=                        # Danish Tax Agency (SKAT) reporting API [optional — mock in pilot]
NEMREFUSION_ZK_GATEWAY=                   # NemRefusion zero-knowledge sickness declaration gateway

# ── EU Regulatory APIs ──
EURLEX_API_URL=https://eur-lex.europa.eu   # EUR-Lex legislative database
EU_VAT_PORTAL_URL=https://ec.europa.eu/taxation_customs/vat  # EU VAT portal for OSS/IOSS settlement

# ── Customs & Trade ──
FLAT_CUSTOMS_DUTY_EUR=3.00               # EU 2026 Customs Reform flat duty per HS code (€)
EUR_TO_DKK_RATE=7.46                     # Currency conversion rate (EUR to DKK)
MONTHLY_MAINTENANCE_CAP_DKK=250          # Household asset twin monthly maintenance cap (DKK)

# ── Planetary Shield (WHO Biosecurity) ──
WHO_TELEMETRY_FEED_URL=                  # WHO pathogen telemetry feed endpoint [optional — mock in pilot]
WHO_WEBHOOK_SECRET=                      # Secret token for WHO webhook signature verification

# ── s.net Audit Ledger ──
SNET_AUDIT_LOG_ENDPOINT=                 # s.net immutable decision ledger endpoint [optional — internal in pilot]

# ── Default Geographic Coordinates (Copenhagen fallback) ──
DEFAULT_CITIZEN_LAT=55.6761              # Fallback latitude for reverse geocoding (København)
DEFAULT_CITIZEN_LNG=12.5683              # Fallback longitude for reverse geocoding (København)

# ── Deployment Phase ──
DEPLOYMENT_PHASE=pilot                   # 'pilot' (DK) or 'eu' (EU expansion)
RLS_ENABLED=true                          # Enable row-level security (true in production)
